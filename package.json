{
  "name": "toph-to-github",
  "version": "1.0.0",
  "description": "Automatic C++ problem solver and GitHub sync for Toph.co",
  "main": "cli/toph.js",
  "scripts": {
    "ide": "node ide/server.js",
    "start": "node ide/server.js",
    "toph": "node cli/toph.js",
    "init": "node cli/toph.js init",
    "generate-icons": "node generate_icons.js",
    "package:zip": "powershell Compress-Archive -Path .\\extension\\* -DestinationPath .\\tophhub-extension.zip -Force"
  },
  "keywords": [
    "toph",
    "toph.co",
    "github-sync",
    "competitive-programming",
    "cpp"
  ],
  "author": "",
  "license": "MIT"
}

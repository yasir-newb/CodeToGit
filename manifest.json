{
  "manifest_version": 3,
  "name": "CodeToGit (CTG) - CP to GitHub Sync",
  "version": "1.0.0",
  "description": "Automatically sync your accepted C++ problem solutions and submissions on Toph.co & Codeforces to GitHub.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CodeToGit (CTG) Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://toph.co/*",
    "https://codeforces.com/*",
    "https://*.codeforces.com/*",
    "https://api.github.com/*",
    "https://ce.judge0.com/*",
    "https://emkc.org/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://toph.co/*",
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "css": [
        "scripts/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "ide/*"
      ],
      "matches": [
        "https://toph.co/*",
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ]
    }
  ]
}
